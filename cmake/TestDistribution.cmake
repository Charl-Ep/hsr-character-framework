cmake_minimum_required(VERSION 3.25)
set(output "${BUILD_ROOT}/package-test")
execute_process(COMMAND "${CPACK}" --config "${BUILD_ROOT}/CPackConfig.cmake"
    -C "${CONFIG}" -B "${output}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Package failed: ${out}\n${err}")
endif()
set(archive "${output}/${ARCHIVE_NAME}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
    RESULT_VARIABLE result OUTPUT_VARIABLE members ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot list package: ${err}")
endif()
string(REPLACE "\r" "" members "${members}")
string(REPLACE "\n" ";" members "${members}")
foreach(required Hksr.Api.dll Hksr.CharacterFramework.dll package.json LICENSE AudioCatalog/events.json
                 docs/script-api.md docs/script-api.d.ts docs/examples/standby.script.json)
    if(NOT "CharacterFramework/${required}" IN_LIST members)
        message(FATAL_ERROR "Package is missing ${required}")
    endif()
endforeach()
foreach(member IN LISTS members)
    if(member MATCHES "(RuntimeInspection|runtime-inspection|framework-runtime\\.log|http-settings\\.cfg|(^|/)layouts/|VISUAL_PROGRAMS\\.json|(^|/)(TaskCatalogs|VisualPrograms)/)")
        message(FATAL_ERROR "Unexpected runtime/development data in package: ${member}")
    endif()
endforeach()
# This directory contains only this test's extracted package. Do not let files
# from an earlier archive satisfy a missing dependency in the current one.
file(REMOVE_RECURSE "${output}/unpacked")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${output}/unpacked")
set(package_root "${output}/unpacked/CharacterFramework")
set(AUDIO_CATALOG_FILE "${package_root}/AudioCatalog/events.json")
include("${CMAKE_CURRENT_LIST_DIR}/CheckAudioCatalog.cmake")
file(GLOB_RECURSE scripts "${package_root}/Scripts/*.script.json")
if(NOT scripts)
    message(FATAL_ERROR "Product script directory is empty")
endif()
foreach(script IN LISTS scripts)
    file(READ "${script}" definition)
    string(JSON format GET "${definition}" format)
    if(NOT format STREQUAL "hksr.script")
        message(FATAL_ERROR "Unexpected script format in ${script}: ${format}")
    endif()
endforeach()
file(GLOB_RECURSE definitions "${package_root}/Scripts/*.json")
foreach(definition IN LISTS definitions)
    file(READ "${definition}" document)
    string(JSON import_count ERROR_VARIABLE no_imports LENGTH "${document}" imports)
    if(no_imports)
        continue()
    endif()
    if(import_count GREATER 0)
        math(EXPR last_import "${import_count} - 1")
        foreach(index RANGE 0 ${last_import})
            string(JSON dependency GET "${document}" imports ${index})
            get_filename_component(import_file "${package_root}/Scripts/${dependency}" ABSOLUTE)
            file(RELATIVE_PATH import_member "${output}/unpacked" "${import_file}")
            if(NOT "${import_member}" IN_LIST members)
                message(FATAL_ERROR "Packaged script import is missing: ${dependency}")
            endif()
        endforeach()
    endif()
endforeach()
execute_process(COMMAND "${SCRIPT_READER}" --script-directory "${package_root}/Scripts"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Packaged script composition failed: ${out}\n${err}")
endif()
file(READ "${output}/unpacked/CharacterFramework/package.json" metadata)
string(JSON flavor GET "${metadata}" build_flavor)
if(NOT flavor STREQUAL "runtime")
    message(FATAL_ERROR "Product package has wrong build flavor: ${flavor}")
endif()
execute_process(COMMAND "${LOADER}" "${output}/unpacked/CharacterFramework/Hksr.CharacterFramework.dll" runtime
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Packaged DLL loading failed: ${out}\n${err}")
endif()
message(STATUS "Product archive contents and independent DLL loading passed")
