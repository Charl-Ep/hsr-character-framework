cmake_minimum_required(VERSION 3.25)
file(READ "${AUDIO_CATALOG_FILE}" audio_catalog)
string(JSON audio_format GET "${audio_catalog}" format)
if(NOT audio_format STREQUAL "hksr.actor-audio-events")
    message(FATAL_ERROR "Invalid packaged actor audio format")
endif()
set(audio_fields format events native_cues)
string(JSON audio_field_count LENGTH "${audio_catalog}")
if(NOT audio_field_count EQUAL 3)
    message(FATAL_ERROR "Actor audio resource must contain only format, events and native_cues")
endif()
foreach(index RANGE 0 2)
    string(JSON audio_field MEMBER "${audio_catalog}" ${index})
    if(NOT audio_field IN_LIST audio_fields)
        message(FATAL_ERROR "Non-runtime actor audio field: ${audio_field}")
    endif()
endforeach()
foreach(field events native_cues)
    string(JSON audio_field_type TYPE "${audio_catalog}" ${field})
    if(NOT audio_field_type STREQUAL "ARRAY")
        message(FATAL_ERROR "Packaged actor audio ${field} must be an array")
    endif()
endforeach()
string(JSON audio_event_count LENGTH "${audio_catalog}" events)
if(audio_event_count LESS 1)
    message(FATAL_ERROR "Packaged actor audio event mappings are empty")
endif()
