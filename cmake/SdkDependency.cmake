include(FetchContent)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../dependencies.json")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../dependencies.json" DEPENDENCIES)
string(JSON SDK_VERSION GET "${DEPENDENCIES}" sdk version)
string(JSON SDK_INTERFACE GET "${DEPENDENCIES}" sdk interface)
string(JSON SDK_REPOSITORY GET "${DEPENDENCIES}" sdk repository)

# Select from explicit inputs, not a package registry or a previous configure's
# HksrApi_DIR. The manifest pins build inputs, not runtime update compatibility.
set(HKSR_SDK_ROOT "" CACHE PATH "SDK development installation override")
set(HKSR_SDK_ARCHIVE "" CACHE FILEPATH "SDK development ZIP override")
if(HKSR_SDK_ROOT AND HKSR_SDK_ARCHIVE)
    message(FATAL_ERROR "Choose HKSR_SDK_ROOT or HKSR_SDK_ARCHIVE, not both")
endif()
unset(HksrApi_DIR CACHE)
unset(HksrApi_DIR)
if(HKSR_SDK_ROOT)
    find_package(HksrApi ${SDK_VERSION} CONFIG REQUIRED COMPONENTS abi${SDK_INTERFACE}
        PATHS "${HKSR_SDK_ROOT}" NO_DEFAULT_PATH)
else()
    set(ARCHIVE_NAME "HksrApi-${SDK_VERSION}-win64-msvc${MSVC_TOOLSET_VERSION}-Release.zip")
    if(HKSR_SDK_ARCHIVE)
        get_filename_component(SDK_URL "${HKSR_SDK_ARCHIVE}" ABSOLUTE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SDK_URL}")
        # A developer can replace a ZIP at the same path. FetchContent's URL
        # stamp alone does not notice that; use local file metadata, not hashes.
        file(TIMESTAMP "${SDK_URL}" SDK_TIME "%Y-%m-%dT%H:%M:%S.%fZ" UTC)
        file(SIZE "${SDK_URL}" SDK_SIZE)
        set(SDK_INPUT "${SDK_URL}\n${SDK_TIME}\n${SDK_SIZE}\n")
        set(hksr_sdk_SOURCE_DIR "${CMAKE_CURRENT_BINARY_DIR}/sdk-archive")
        set(SDK_PREVIOUS "")
        if(EXISTS "${hksr_sdk_SOURCE_DIR}/.archive-input")
            file(READ "${hksr_sdk_SOURCE_DIR}/.archive-input" SDK_PREVIOUS)
        endif()
        if(NOT SDK_INPUT STREQUAL SDK_PREVIOUS)
            # Only this generated child directory is replaced. Never erase an
            # override installation or follow a symlink to developer sources.
            set(SDK_BUILD_DIR "${CMAKE_CURRENT_BINARY_DIR}")
            cmake_path(IS_PREFIX SDK_BUILD_DIR "${hksr_sdk_SOURCE_DIR}" NORMALIZE SDK_INSIDE_BUILD)
            if(NOT SDK_INSIDE_BUILD OR IS_SYMLINK "${hksr_sdk_SOURCE_DIR}")
                message(FATAL_ERROR "Unsafe SDK extraction destination: ${hksr_sdk_SOURCE_DIR}")
            endif()
            file(REMOVE_RECURSE "${hksr_sdk_SOURCE_DIR}")
            file(ARCHIVE_EXTRACT INPUT "${SDK_URL}" DESTINATION "${hksr_sdk_SOURCE_DIR}")
            file(WRITE "${hksr_sdk_SOURCE_DIR}/.archive-input" "${SDK_INPUT}")
        endif()
    else()
        if(CMAKE_BUILD_TYPE STREQUAL "Debug")
            message(FATAL_ERROR "Debug requires a Debug SDK via HKSR_SDK_ROOT or HKSR_SDK_ARCHIVE")
        endif()
        set(SDK_URL "https://github.com/${SDK_REPOSITORY}/releases/download/v${SDK_VERSION}/${ARCHIVE_NAME}")
        FetchContent_Declare(hksr_sdk URL "${SDK_URL}" TLS_VERIFY TRUE
            DOWNLOAD_EXTRACT_TIMESTAMP TRUE SOURCE_SUBDIR _hksr_binary_package)
        FetchContent_MakeAvailable(hksr_sdk)
    endif()
    find_package(HksrApi ${SDK_VERSION} EXACT CONFIG REQUIRED COMPONENTS abi${SDK_INTERFACE}
        PATHS "${hksr_sdk_SOURCE_DIR}" NO_DEFAULT_PATH)
endif()
message(STATUS "SDK ${HksrApi_VERSION}, interface ${HksrApi_INTERFACE_GENERATION}: ${HksrApi_DIR}")
