# Checks dependencies only. Never adds game-side guards or changes scheduling.
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(GLOB_RECURSE HEADERS "${ROOT}/include/*.hpp")
file(GLOB_RECURSE SOURCES "${ROOT}/src/*.hpp" "${ROOT}/src/*.cpp")
foreach(FILE IN LISTS HEADERS SOURCES)
    file(READ "${FILE}" TEXT)
    if(TEXT MATCHES "api::([A-Za-z0-9_]*Methods|Method|DeclaredField)([^A-Za-z0-9_]|$)" OR TEXT MATCHES "[.>]Bindings\\(")
        message(FATAL_ERROR "Framework consumes SDK capabilities, not engine binding tables: ${FILE}")
    endif()
    if(NOT FILE MATCHES "/src/(serialization|http)/" AND TEXT MATCHES "#include[ \t]*[<\"]nlohmann/|nlohmann::")
        message(FATAL_ERROR "JSON escaped the protocol/serialization boundary: ${FILE}")
    endif()
    if(NOT FILE MATCHES "/src/(host|http|ui)/" AND TEXT MATCHES "#include[^\n]*(HttpControl|HttpProtocol|Overlay|Menu|PresentHook)\\.hpp")
        message(FATAL_ERROR "Core module depends on a frontend: ${FILE}")
    endif()
endforeach()
